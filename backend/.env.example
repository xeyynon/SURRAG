# Optional: set this to use Groq (LLM-based) extraction instead of spaCy fallback.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Demo API key required on mutating endpoints (POST /api/analyze).
# Stands in for the architecture's Auth & Access Service — not real auth.
CRIMELINK_API_KEY=demo-investigator-key

# Postgres (tabular store) — defaults match docker-compose.yml
CRIMELINK_PG_DSN=postgresql://crimelink:crimelink@localhost:5432/crimelink

# Neo4j (graph store) — defaults match docker-compose.yml
CRIMELINK_NEO4J_URI=bolt://localhost:7687
CRIMELINK_NEO4J_USER=neo4j
CRIMELINK_NEO4J_PASSWORD=crimelink123

# Qdrant (vector store) — defaults match docker-compose.yml
CRIMELINK_QDRANT_URL=http://localhost:6333
